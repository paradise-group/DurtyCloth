<Window x:Class="FooxClothStudio.TextureNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nome da textura" Width="420" Height="170"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#25282C" Foreground="White">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Text="Nome da nova textura dentro do YTD" Margin="0,0,0,8"/>
        <TextBox x:Name="NameBox" Height="28"/>
        <TextBlock x:Name="ErrorText" Foreground="#FF9A9A" Margin="0,6,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancelar" IsCancel="True" Width="80" Margin="0,0,8,0"/>
            <Button x:Name="AcceptButton" Content="Adicionar" IsDefault="True" Width="80" Click="Accept_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
