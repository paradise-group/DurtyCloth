<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../ModelPreview.cs" Link="ModelPreview.cs" />
    <Compile Include="../../TextureReferenceCoverage.cs" Link="TextureReferenceCoverage.cs" />
    <Reference Include="CodeWalker.Core">
      <HintPath>$(CodeWalkerDir)\CodeWalker.Core.dll</HintPath>
    </Reference>
    <Reference Include="SharpDX">
      <HintPath>$(CodeWalkerDir)\SharpDX.dll</HintPath>
    </Reference>
    <Reference Include="SharpDX.Mathematics">
      <HintPath>$(CodeWalkerDir)\SharpDX.Mathematics.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
