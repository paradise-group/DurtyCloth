<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ParadiseClothStudio</AssemblyName>
    <Product>Paradise Cloth Studio</Product>
    <ApplicationIcon>Assets\paradise-shirt.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/paradise-shirt.ico" />
    <Compile Remove="tools/**" />
    <Page Remove="tools/**" />
    <ApplicationDefinition Remove="tools/**" />
    <None Remove="tools/**;publish/**" />
    <Content Remove="tools/**;publish/**" />
    <EmbeddedResource Remove="tools/**;publish/**" />
    <Reference Include="CodeWalker.Core">
      <HintPath>$(CodeWalkerDir)\CodeWalker.Core.dll</HintPath>
    </Reference>
    <Reference Include="SharpDX">
      <HintPath>$(CodeWalkerDir)\SharpDX.dll</HintPath>
    </Reference>
    <Reference Include="SharpDX.Mathematics">
      <HintPath>$(CodeWalkerDir)\SharpDX.Mathematics.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="SkiaSharp" Version="4.156.1" GeneratePathProperty="true" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.156.1" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgSkiaSharp)/LICENSE.txt" Link="licenses/SkiaSharp-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgSkiaSharp_NativeAssets_Win32)/THIRD-PARTY-NOTICES.txt" Link="licenses/Skia-THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
