<Window x:Class="FooxClothStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FooxClothStudio"
        Icon="Assets/paradise-shirt.ico" Title="Paradise Cloth Studio" Width="1280" Height="860" MinWidth="960" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="#1D1F22" Foreground="#F0F1F2" FontFamily="Segoe UI" FontSize="12" PreviewKeyDown="Window_PreviewKeyDown" AllowDrop="True" PreviewDragOver="Clothing_DragOver" PreviewDrop="Clothing_Drop">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="MenuTheme.xaml"/></ResourceDictionary.MergedDictionaries>
        <local:ClothLabelConverter x:Key="ClothLabel"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F0F1F2"/></Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#F0F1F2"/><Setter Property="Background" Value="#363A40"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" Padding="8,5" BorderBrush="#51565D" BorderThickness="0,0,0,1"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#9B71E8"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,0,2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#363A40"/>
            <Setter Property="Foreground" Value="#F0F1F2"/>
            <Setter Property="BorderBrush" Value="#51565D"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#17191C"/>
            <Setter Property="Foreground" Value="#F0F1F2"/>
            <Setter Property="BorderBrush" Value="#51565D"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#363A40"/>
            <Setter Property="Foreground" Value="#17191C"/>
            <Setter Property="BorderBrush" Value="#51565D"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#25282C"/>
            <Setter Property="Foreground" Value="#F0F1F2"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="Expander"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><Path x:Name="Arrow" Data="M 2,2 L 6,6 L 2,10" Stroke="#B8BCC1" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/><ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
            </ToggleButton><ContentPresenter x:Name="Body" ContentSource="Content" Margin="18,0,0,0" Visibility="Collapsed"/>
        </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" Background="#292D31" Foreground="#F0F1F2">
            <MenuItem x:Name="ProjectMenu" Header="Project">
                <MenuItem x:Name="NewProjectMenuItem" Header="New project" Click="New_Click"/>
                <MenuItem x:Name="OpenProjectMenuItem" Header="Open project" Click="Open_Click"/>
                <MenuItem x:Name="RecentFilesMenu" Header="Recent files"/>
                <MenuItem Header="Save" Click="Save_Click"/>
                <MenuItem Header="Save as" Click="SaveAs_Click"/>
                <Separator/>
                <MenuItem Header="Import package" Click="ImportBundle_Click"/>
                <MenuItem Header="Export project" Click="ExportBundle_Click"/>
                <MenuItem Header="Open FiveM resource" Click="OpenResource_Click"/>
                <MenuItem Header="Copy resource" Click="CopyResource_Click"/>
            </MenuItem>
            <MenuItem Header="Options">
                <MenuItem Header="Project Settings" Click="Settings_Click"/>
                <MenuItem Header="Add" Click="ImportFiles_Click"/>
                <MenuItem Header="Add folder" Click="ImportFolder_Click"/>
                <MenuItem Header="Add tattoo / Edit tattoos" Click="Tattoos_Click"/>
                <MenuItem Header="Export selected drawable" Click="ExportItemFiles_Click"/>
                <MenuItem Header="Export selected package" Click="ExportItemBundle_Click"/>
                <MenuItem Header="Export stream" Click="Export_Click"/>
            </MenuItem>
            <MenuItem Header="View"><MenuItem Header="Error List" Click="Validate_Click"/></MenuItem>
            <MenuItem Header="Help" Click="Help_Click"/>
        </Menu>
        <Grid Grid.Row="1" Margin="4,8,4,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="33*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="67*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#25282C" BorderBrush="#42464C" BorderThickness="1" CornerRadius="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="64"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="6">
                        <TextBlock Text="Drawables" Margin="0,0,0,4"/>
                        <Grid><TextBox x:Name="SearchBox" TextChanged="Filter_Changed" ToolTip="Enter search term (CTRL+F)"/><TextBlock Text="Enter search term (CTRL+F)" FontStyle="Italic" Foreground="#A8ADB4" VerticalAlignment="Center" Margin="6,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                        <ComboBox x:Name="CategoryList" Visibility="Collapsed" SelectionChanged="Filter_Changed" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="ItemList" Grid.Row="1" Margin="6,0" IsSynchronizedWithCurrentItem="False" SelectionChanged="ItemList_SelectionChanged" MouseDoubleClick="PreviewList_DoubleClick" PreviewMouseRightButtonDown="SelectContextRow" ContextMenuOpening="ItemContextMenu_Opening">
                        <ListBox.ContextMenu><ContextMenu Background="#25282C" Foreground="#F0F1F2"/></ListBox.ContextMenu>
                        <ListBox.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander IsExpanded="True" Foreground="#F0F1F2" Loaded="Category_Loaded" Expanded="Category_ExpansionChanged" Collapsed="Category_ExpansionChanged"><Expander.Header><TextBlock Text="{Binding Converter={StaticResource ClothLabel}}"/></Expander.Header><ItemsPresenter/></Expander></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#3A3E44" BorderThickness="0" Padding="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="16"><Grid Width="16" Height="16" ToolTip="{Binding WeightHint}"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HeavyAsset}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Path Fill="#FFB900" Data="M 0,14 L 8,0 L 16,14 Z"/><TextBlock Text="!" Foreground="#161616" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/></Grid>
                                        <TextBlock Text="❗" Foreground="#FF4545" FontWeight="Bold" Margin="0,0,6,0" ToolTip="Missing texture: add a YTD variation to this drawable.">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding MissingTexture}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock></Grid>
                                        <TextBlock Text="{Binding GenderIcon}" FontFamily="Segoe UI Symbol" FontSize="14" FontWeight="Bold" Margin="0,0,5,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#BBBBBB"/><Style.Triggers><DataTrigger Binding="{Binding Gender}" Value="Masculino"><Setter Property="Foreground" Value="#269DE8"/></DataTrigger><DataTrigger Binding="{Binding Gender}" Value="Feminino"><Setter Property="Foreground" Value="#F5A2B8"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        <Viewbox Width="14" Height="14" Margin="0,0,5,0" ToolTip="Drawable model"><Path Stroke="#DDE0E3" StrokeThickness="1.4" Data="M 2,5 L 8,1 L 14,5 L 14,12 L 8,16 L 2,12 Z M 2,5 L 8,9 L 14,5 M 8,9 L 8,16 M 8,1 L 8,9"/></Viewbox>
                                        <TextBlock Text="{Binding RowLabel}" FontWeight="Normal"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Margin="10,5">
                        <WrapPanel>
                            <Button Content="Import package" Click="ImportItemBundle_Click"/>
                            <Button x:Name="AddButton" Content="Add" Click="AddMenu_Click"/>
                            <Button x:Name="AddMaleButton" Content="Add Male" Tag="Masculino" Click="AddMenu_Click"/>
                            <Button x:Name="AddFemaleButton" Content="Add Female" Tag="Feminino" Click="AddMenu_Click"/>
                        </WrapPanel>
                        <Button Content="Remove" Click="Remove_Click" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        <TextBlock x:Name="CountText" Visibility="Collapsed" Foreground="#B7BDC4" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="#25282C" BorderBrush="#42464C" BorderThickness="1" CornerRadius="0">
                <Grid>
                <TextBlock x:Name="EmptyEditorText" Text="Drawable is not selected" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="EditorPanel" Margin="8">
                    <TextBlock Text="Edit selected drawable" FontWeight="SemiBold" Foreground="#B7BDC4" Margin="0,0,0,4"/>
                    <TabControl Background="#25282C" Foreground="#F0F1F2">
                    <TabItem Header="General"><Grid Margin="6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Position"/><TextBox x:Name="PositionBox" Margin="0,4,0,0" LostFocus="Metadata_LostFocus"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Cloth type"/><ComboBox x:Name="ClothKindBox" Margin="0,4,0,0" SelectionChanged="ClothKind_Changed"><ComboBoxItem Content="Component (Shirt, Pants, Torso etc.)"/><ComboBoxItem Content="Prop (Hat, Glasses etc.)"/></ComboBox></StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Text="Drawable type"/><ComboBox x:Name="TypeBox" Margin="0,4,0,10" SelectionChanged="Details_Changed"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ClothLabel}, ConverterParameter=Detailed}" Foreground="#F0F1F2"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Gender"/><ComboBox x:Name="GenderBox" Margin="0,4,0,0" SelectionChanged="Details_Changed"><ComboBoxItem Content="Undefined" Tag="Indefinido"/><ComboBoxItem Content="Male" Tag="Masculino"/><ComboBoxItem Content="Female" Tag="Feminino"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Name"/><TextBox x:Name="ItemNameBox" Margin="0,4,0,0" LostFocus="ItemNameBox_LostFocus"/></StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock x:Name="AlternateModelHeading" Text="First person model"/><DockPanel Margin="0,4,0,10"><Button x:Name="ChooseAlternateButton" DockPanel.Dock="Right" Content="..." Click="ChooseAlternate_Click" Margin="0"/><Button DockPanel.Dock="Right" Content="×" Click="RemoveAlternateModel_Click"/><Grid><ListBox x:Name="AlternateModelList" Height="25"/><TextBlock Text="Select a file" Foreground="#A8ADB4" Margin="6,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=AlternateModelList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0"><TextBlock Text="Audio preset"/><ComboBox x:Name="AudioBox" IsEditable="True" Margin="0,4,0,10" LostFocus="Metadata_LostFocus"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Mesh physics file (.yld)"/><DockPanel Margin="0,4,0,10"><Button DockPanel.Dock="Right" Content="..." Click="SetPhysics_Click" Margin="0"/><Button DockPanel.Dock="Right" Content="×" Click="RemovePhysics_Click"/><TextBlock x:Name="PhysicsText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></StackPanel>
                        <Grid Grid.Row="3" Grid.ColumnSpan="3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock x:Name="TexturesHeading" Text="Textures 0/26" Margin="0,0,0,5"/>
                                <ListBox x:Name="TextureList" Grid.Row="1" Height="612" SelectionChanged="TextureList_SelectionChanged" MouseDoubleClick="PreviewList_DoubleClick" PreviewMouseRightButtonDown="SelectContextRow" ContextMenuOpening="TextureContextMenu_Opening"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="▧" FontSize="17" Margin="0,0,8,0"/><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ListBox.ItemTemplate><ListBox.ContextMenu><ContextMenu Background="#25282C" Foreground="#F0F1F2"/></ListBox.ContextMenu></ListBox>
                                <WrapPanel Grid.Row="2" Margin="0,5,0,0"><Button Content="Add" Click="AddTexture_Click"/><Button Content="Add dummy" Click="AddDummyTexture_Click"/><Button Content="Remove selected" Click="RemoveTexture_Click"/><Button Content="▲" Click="MoveTextureUp_Click"/><Button Content="▼" Click="MoveTextureDown_Click"/><Button Content="3D Preview Cloth" Click="Preview_Click"/></WrapPanel>
                            </Grid>
                            <StackPanel Grid.Column="2"><TextBlock Text="Options" Margin="0,0,0,12"/><TextBlock Text="Behaviour Flags"/><ComboBox x:Name="BehaviourBox" IsEditable="True" Margin="0,4,0,12" LostFocus="Metadata_LostFocus" ToolTip="Default or raw CComponentInfo flags (unsigned 32-bit)"/>
                                <StackPanel x:Name="HairPanel"><StackPanel x:Name="HairControlsPanel"><TextBlock Text="Hair Options"/><ListBox x:Name="HairOptionBox" Margin="0,4,0,8" SelectionChanged="HairOptions_Changed" BorderThickness="1" BorderBrush="#51565D"><ListBox.ContextMenu><ContextMenu><MenuItem Header="Custom cut hairs" Click="CustomHair_Click"/></ContextMenu></ListBox.ContextMenu><ListBoxItem Content="Show hairs"/><ListBoxItem Content="Cut hairs"/><ListBoxItem Content="Remove hairs"/><ListBoxItem x:Name="CustomHairOption" Content="Custom cut hairs"/></ListBox>
                                <StackPanel x:Name="CustomHairPanel"><TextBlock Text="Custom cut amount (-1 to 0)"/><TextBox x:Name="HairCutBox" Margin="0,4,0,8" LostFocus="Metadata_LostFocus"/></StackPanel></StackPanel>
                                <CheckBox x:Name="HoodieBox" Content="Hoodie hairs" Checked="Hoodie_Changed" Unchecked="Hoodie_Changed" Foreground="#F0F1F2"/>
                                </StackPanel>
                                <StackPanel x:Name="HeelPanel"><TextBlock Text="Heel Height" Margin="0,8,0,4"/><TextBox x:Name="HeelBox" LostFocus="Metadata_LostFocus"/></StackPanel>
                                <StackPanel x:Name="FirstPersonOptionsPanel"><TextBlock Text="First Person options" Margin="0,10,0,6"/>
                                <TextBlock Text="Mask Model"/><ComboBox x:Name="MaskModelBox" IsEditable="True" Margin="0,4,0,8" LostFocus="Metadata_LostFocus"/>
                                <TextBlock Text="Mask offset X / Y / Z"/><WrapPanel><TextBox x:Name="MaskXBox" Width="52" LostFocus="Metadata_LostFocus"/><TextBox x:Name="MaskYBox" Width="52" LostFocus="Metadata_LostFocus"/><TextBox x:Name="MaskZBox" Width="52" LostFocus="Metadata_LostFocus"/></WrapPanel>
                                <TextBlock Text="TimeCycle Modifier" Margin="0,8,0,4"/><ComboBox x:Name="TimeCycleBox" IsEditable="True" LostFocus="TextureEffect_LostFocus"/>
                                <TextBlock Text="TimeCycle Intensity" Margin="0,8,0,4"/><TextBox x:Name="TimeCycleIntensityBox" LostFocus="TextureEffect_LostFocus"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid></TabItem>
                    <TabItem Header="Shop Meta"><StackPanel Margin="6">
                        <TextBlock Text="Cost"/><TextBox x:Name="ShopCostBox" LostFocus="Metadata_LostFocus" Margin="0,4,0,12"/>
                        <TextBlock Text="Text label"/><TextBox x:Name="ShopLabelBox" LostFocus="Metadata_LostFocus" Margin="0,4,0,12"/>
                        <TextBlock Text="Lock hash"/><TextBox x:Name="ShopLockBox" LostFocus="Metadata_LostFocus" Margin="0,4,0,12"/>
                    </StackPanel></TabItem>
                    <TabItem Header="Creator Info"><StackPanel Margin="6">
                        <TextBlock Text="Creator"/><TextBox x:Name="CreatorBox" LostFocus="Metadata_LostFocus" Margin="0,4,0,12"/>
                        <TextBlock Text="Website"/><TextBox x:Name="CreatorWebsiteBox" LostFocus="Metadata_LostFocus" Margin="0,4,0,12"/>
                        <TextBlock Text="Description"/><TextBox x:Name="CreatorDescriptionBox" LostFocus="Metadata_LostFocus" AcceptsReturn="True" Height="90" Margin="0,4,0,12"/>
                    </StackPanel></TabItem>
                    <TabItem x:Name="PreviewTab" Visibility="Collapsed" Header="3D Preview Cloth"><StackPanel Margin="6">
                    <TextBlock Text="Main model"/><TextBlock x:Name="ModelText" TextWrapping="Wrap"/><TextBlock x:Name="ModelInfoText" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,6,0,12"><Button Content="Select main model" Click="ReplaceModel_Click"/><Button Content="Replace texture" Click="ReplaceTexture_Click"/><Button Content="Export native files" Click="ExportItemFiles_Click"/><Button Content="Move alternate up" Click="MoveAlternateModelUp_Click"/><Button Content="Move alternate down" Click="MoveAlternateModelDown_Click"/></WrapPanel>

                    <TextBlock Text="3D Preview Cloth" Foreground="#B7BDC4"/>
                    <CheckBox x:Name="UnlockModelPed" Content="Destravar ped" Margin="0,5,0,0" Unchecked="LockModelPed_Unchecked"/>
                    <Border Height="220" Margin="0,5,0,5">
                        <Border.Background><RadialGradientBrush GradientOrigin="0.48,0.32" Center="0.5,0.4" RadiusX="0.8" RadiusY="0.85"><GradientStop Color="#303E59" Offset="0"/><GradientStop Color="#192032" Offset="0.55"/><GradientStop Color="#0C101C" Offset="1"/></RadialGradientBrush></Border.Background>
                        <Viewport3D x:Name="ModelViewport" ClipToBounds="True"
                                    MouseDown="ModelViewport_MouseDown" MouseMove="ModelViewport_MouseMove"
                                    MouseUp="ModelViewport_MouseUp" MouseWheel="ModelViewport_MouseWheel">
                            <Viewport3D.Camera>
                                <PerspectiveCamera Position="0,0,3.3" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="45"/>
                            </Viewport3D.Camera>
                            <ModelVisual3D x:Name="ModelPreviewVisual"/>
                        </Viewport3D>
                    </Border>
                    <TextBlock x:Name="ModelPreviewText" Foreground="#B7BDC4" TextWrapping="Wrap" Margin="0,0,0,15"/>
                    <TextBlock Text="Textures referenced by the model" Foreground="#B7BDC4"/>
                    <ListBox x:Name="TextureReferencesList" Height="90" Margin="0,5,0,12"/>
                    <TextBlock Text="Texture entry" Foreground="#B7BDC4"/>
                    <ComboBox x:Name="TextureEntryBox" Margin="0,5,0,12" SelectionChanged="TextureEntryBox_SelectionChanged"/>
                    <TextBlock Text="Texture preview" Foreground="#B7BDC4"/>
                    <Border Background="#17191C" Height="170" Margin="0,5,0,5">
                        <Image x:Name="TexturePreview" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="TexturePreviewText" Foreground="#B7BDC4" TextWrapping="Wrap" Margin="0,0,0,15"/>
                    <Button Content="Save texture as PNG" Click="SaveTexturePng_Click" Margin="0,0,0,15"/>
                    <Button Content="Save texture as DDS (all mipmaps)" Click="SaveTextureDds_Click" Margin="0,0,0,15"/>
                    <Button Content="Replace texture entry with PNG/DDS" Click="ReplaceInnerTexture_Click" Margin="0,0,0,15"/>
                    <WrapPanel Margin="0,0,0,15">
                        <Button Content="Add texture entry" Click="AddInnerTexture_Click" Margin="0,0,8,0"/>
                        <Button Content="Remove texture entry" Click="RemoveInnerTexture_Click"/>
                    </WrapPanel>
                    <Button Content="Rename texture entry" Click="RenameInnerTexture_Click" Margin="0,0,0,15"/>
                    <Border Background="#1C1E21" Padding="12">
                        <TextBlock Text="The preview applies matching diffuse textures and UV coordinates." TextWrapping="Wrap" Foreground="#B7BDC4"/>
                    </Border>
                    </StackPanel></TabItem>
                    </TabControl>
                </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#292D31" BorderBrush="#42464C" BorderThickness="0,1,0,0">
          <StackPanel>
            <Expander x:Name="DuplicateReview" Header="Revisar texturas duplicadas" Foreground="#DCC7FF" Margin="8,5" Expanded="DuplicateReview_Expanded">
              <StackPanel>
                <DockPanel Margin="0,3,0,5"><Button x:Name="RefreshDuplicateReviewButton" DockPanel.Dock="Right" Content="Atualizar comparação" Click="RefreshDuplicateReview_Click"/><TextBlock x:Name="DuplicateReviewStatus" Text="Abra para comparar as duplicadas do projeto." TextWrapping="Wrap"/></DockPanel>
                <ComboBox x:Name="DuplicatePairList" SelectionChanged="DuplicatePairList_SelectionChanged" Margin="0,0,8,5"/>
                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DuplicateComparison"/></ScrollViewer>
              </StackPanel>
            </Expander>
            <DockPanel Margin="8,0" MinHeight="36">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Error List" Click="Validate_Click"/>
                    <Button Content="Settings" Click="Settings_Click"/>
                    <Button Content="Build project" Click="ExportAddon_Click" Background="#9B71E8" Margin="0"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ProjectText" Visibility="Collapsed" Foreground="#B7BDC4" FontSize="10"/>
                    <TextBlock x:Name="StatusText" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>
    </Grid>
</Window>

